{
  "name": "agent-wrapped",
  "version": "0.1.0",
  "description": "Your year with AI coding agents, played back in keyboard keys. Reads Claude Code and Codex logs on your computer.",
  "keywords": [
    "claude-code",
    "codex",
    "ai",
    "wrapped",
    "year-in-review",
    "cli"
  ],
  "homepage": "https://agent-wrapped.shadev.space/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shadevkumar/agent-wrapped.git"
  },
  "bugs": {
    "url": "https://github.com/shadevkumar/agent-wrapped/issues"
  },
  "author": "Shadev Kumar",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "agent-wrapped": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning src/cli.ts",
    "test": "TZ=UTC node --test --disable-warning=ExperimentalWarning 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/story', 'dist/story', { recursive: true })\"",
    "prepack": "npm run build",
    "build:player": "node --disable-warning=ExperimentalWarning scripts/build-player.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
